    "event":  [
                  {
                      "listen":  "prerequest",
                      "script":  {
                                     "type":  "text/javascript",
                                     "exec":  [
                                                  "if (!pm.environment || pm.environment.name !== \"SecureVault Local — Private Test Values\") {",
                                                  "  pm.execution.skipRequest();",
                                                  "}",
                                                  "if (pm.environment.get(\"base_url\") !== \"http://127.0.0.1:18080\") {",
                                                  "  pm.execution.skipRequest();",
                                                  "}",
                                                  "function initialize(key, value) {",
                                                  "  if (!pm.environment.get(key)) pm.environment.set(key, value);",
                                                  "}",
                                                  "initialize(\"run_id\", pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g, \"\").slice(0, 12));",
                                                  "const run = pm.environment.get(\"run_id\");",
                                                  "initialize(\"test_username\", \"svpm_owner_\" + run);",
                                                  "initialize(\"test_recipient\", \"svpm_recipient_\" + run);",
                                                  "initialize(\"test_email\", pm.environment.get(\"test_username\") + \"@example.test\");",
                                                  "initialize(\"recipient_email\", pm.environment.get(\"test_recipient\") + \"@example.test\");",
                                                  "initialize(\"external_recipient\", \"svpm_external_\" + run + \"@example.test\");",
                                                  "initialize(\"external_revoke_recipient\", \"svpm_revoke_\" + run + \"@example.test\");",
                                                  "initialize(\"external_expiry_recipient\", \"svpm_expiry_\" + run + \"@example.test\");",
                                                  "for (const key of [\"test_password\", \"recipient_password\", \"new_test_password\", \"vault_password\", \"wrong_password\"]) {",
                                                  "  initialize(key, \"SvPm!\" + pm.variables.replaceIn(\"{{$guid}}\"));",
                                                  "}",
                                                  "initialize(\"device_id\", pm.variables.replaceIn(\"{{$guid}}\"));",
                                                  "initialize(\"unknown_uuid\", pm.variables.replaceIn(\"{{$guid}}\"));",
                                                  "initialize(\"unknown_username\", \"svpm_missing_\" + pm.variables.replaceIn(\"{{$guid}}\").slice(0, 8));",
                                                  "initialize(\"invalid_external_token\", (",
                                                  "  pm.variables.replaceIn(\"{{$guid}}\") + pm.variables.replaceIn(\"{{$guid}}\")",
                                                  ").replace(/-/g, \"\").slice(0, 43));",
                                                  "pm.variables.set(\"future_expiry\", new Date(Date.now() + 60 * 60 * 1000).toISOString());"
                                              ]
                                 }
                  }
              ]
