# SecureVault local environment template
#
# Copy this file to .env in the repository root, then fill the required values:
#   Copy-Item .env.example .env
# Docker Compose reads .env automatically. The real .env is ignored by Git.
# Leave no real passwords or private keys in this example file.

# Database credentials
# Required. PostgreSQL's administrator password. Use a unique random value.
POSTGRES_PASSWORD=
# Required. Password for the restricted securevault_app database account.
# Keep this different from POSTGRES_PASSWORD.
SECUREVAULT_DB_APP_PASSWORD=

# Authentication and MFA encryption keys
# Required. Base64-encoded random key material used to sign login tokens.
# Generate a separate 48-byte random value; keep it stable after users sign in.
JWT_SECRET_BASE64=
# Recommended. Separate base64-encoded random key for encrypting authenticator
# seeds stored in the database. Use a different 48-byte random value and keep it
# stable after users enroll. If left blank, the backend falls back to JWT_SECRET_BASE64.
MFA_ENCRYPTION_KEY_BASE64=
# Token lifetime in seconds. 900 seconds is 15 minutes.
JWT_EXPIRATION_SECONDS=900

# Threat detection rule thresholds
# Alert after this many failed sign-ins from the same account and source IP
# within the configured number of minutes. Critical escalation is threshold + 2.
SECUREVAULT_FAILED_LOGIN_THRESHOLD=4
SECUREVAULT_FAILED_LOGIN_WINDOW_MINUTES=5

# Network trust
# Optional. Comma-separated CIDRs for trusted reverse proxies only, for example:
# SECUREVAULT_TRUSTED_PROXY_CIDRS=10.0.0.0/8,192.168.1.10/32
# Leave blank for direct local access.
SECUREVAULT_TRUSTED_PROXY_CIDRS=

# Gmail SMTP for risk-based six-digit email sign-in codes
# Use the Gmail address associated with the app password for username and From.
# Create an app password in Google after enabling 2-Step Verification; do not
# use the normal Gmail account password. Enter the app password without spaces.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SECUREVAULT_MAIL_FROM=

# Leave SMTP username/password/from blank if email verification is not configured.
# Authenticator-app TOTP does not use SMTP and does not require Google API credentials.
