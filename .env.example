# Copy to .env and replace every placeholder. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-unique-random-secret
SECUREVAULT_DB_APP_PASSWORD=replace-with-a-different-random-secret
JWT_SECRET_BASE64=replace-with-a-random-base64-key
MFA_ENCRYPTION_KEY_BASE64=replace-with-a-separate-random-base64-key
JWT_EXPIRATION_SECONDS=900
SECUREVAULT_TRUSTED_PROXY_CIDRS=

# Gmail SMTP for risk-based email verification codes.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SECUREVAULT_MAIL_FROM=
